{
  "name": "nest-next-starter",
  "version": "0.0.1",
  "description": "Full-stack TypeScript monorepo starter: NestJS API (ports and adapters) + Next.js app with Google sign-in, sessions and team management",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=@starter/api",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\""
  },
  "devDependencies": {
    "eslint": "^9.39.2",
    "prettier": "^3.8.1",
    "turbo": "^2.8.1"
  }
}
