# App
APP_ENV=dev
APP_NAME=starter-api
PORT=4000
TRUST_PROXY_HOPS=1
MONGO_URI=mongodb://localhost:27017/starter

# Auth
# At least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=
# OAuth 2.0 Web client ID from Google Cloud Console (same value as the web app)
GOOGLE_CLIENT_ID=
# Comma-separated email domains allowed to sign in (e.g. example.com)
ALLOWED_GOOGLE_DOMAINS=
# Comma-separated web origins allowed by CORS and the CSRF origin check
CORS_ORIGINS=http://localhost:3000

# Observability (optional)
DATADOG_KEY=

# Google Secret Manager (optional, only when APP_ENV=prod)
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=